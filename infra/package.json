{
  "name": "@nomadfinance/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nomad-infra": "dist/bin/app.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "synth": "npm run build && cdk synth",
    "diff": "npm run build && cdk diff",
    "deploy": "npm run build && cdk deploy --all --require-approval never"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.210.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "aws-cdk": "^2.1029.1",
    "esbuild": "^0.25.8",
    "typescript": "^5.5.4"
  }
}
